<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title><%= link.host_name %> está te esperando</title>
<meta property="og:type" content="website">
<meta property="og:url" content="<%= baseUrl %>/go/<%= link.slug %>/<%= token %>">
<meta property="og:title" content="<%= link.host_name %> está te esperando">
<meta property="og:description" content="A participante está na conversa te esperando, acesse agora">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= link.host_name %> está te esperando">
<meta name="twitter:description" content="A participante está na conversa te esperando, acesse agora">
<link rel="stylesheet" href="/css/call.css">
<style>
/* ── Loading overlay ── */
#loading-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: #000;
  z-index: 50;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.2rem;
}
#loading-overlay.visible { display: flex; }
.spinner {
  width: 48px; height: 48px;
  border: 4px solid rgba(255,255,255,0.15);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { color: #aaa; font-size: 0.9rem; font-family: Arial, sans-serif; }

/* ── Erro de vídeo ── */
#video-error {
  display: none;
  position: absolute;
  inset: 0;
  z-index: 15;
  background: #0a0a0a;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  gap: 1rem;
}
#video-error.visible { display: flex; }
#video-error p { color: #aaa; font-size: 0.9rem; font-family: Arial, sans-serif; }
#btn-retry {
  background: rgba(255,255,255,0.15);
  color: #fff;
  border: none;
  border-radius: 10px;
  padding: 12px 2rem;
  font-size: 0.9rem;
  cursor: pointer;
  touch-action: manipulation;
  font-family: Arial, sans-serif;
  margin-top: 0.5rem;
}
</style>
</head>
<body>

<!-- TELA DE CHAMADA RECEBIDA -->
<div id="incoming-screen">
  <div class="incoming-ring"></div>
  <div class="incoming-icon">📞</div>
  <h1 class="incoming-name"><%= link.host_name %></h1>
  <p class="incoming-label">Chamada de vídeo recebida</p>
  <p class="incoming-sub">Entrando como Lead</p>
  <div class="incoming-buttons">
    <button class="btn-decline" id="btn-decline" aria-label="Recusar chamada">✕</button>
    <button class="btn-accept" id="btn-accept" aria-label="Aceitar chamada">📞</button>
  </div>
  <p class="incoming-hint">Toque em aceitar para entrar na chamada</p>
</div>

<!-- LOADING ENQUANTO VÍDEO CARREGA -->
<div id="loading-overlay">
  <div class="spinner"></div>
  <p class="loading-text">Conectando...</p>
</div>

<!-- TELA DE CHAMADA ATIVA -->
<div id="call-screen" class="call-screen" style="display:none;">
  <video id="host-video"
    playsinline
    webkit-playsinline
    x5-playsinline
    x5-video-player-type="h5"
    x5-video-player-fullscreen="true"
    preload="auto"
    muted>
  </video>

  <!-- Erro de carregamento de vídeo -->
  <div id="video-error">
    <p>⚠️ Não foi possível carregar o vídeo.<br>Verifique sua conexão e tente novamente.</p>
    <button id="btn-retry">Tentar novamente</button>
  </div>

  <video id="local-video" autoplay playsinline muted webkit-playsinline></video>

  <div class="call-controls">
    <button class="ctrl-btn" id="btn-mic" aria-label="Microfone">🎤</button>
    <button class="ctrl-btn" id="btn-cam" aria-label="Câmera">📷</button>
    <button class="ctrl-btn" id="btn-speaker" aria-label="Alto-falante">🔊</button>
    <button class="ctrl-btn end" id="btn-end" aria-label="Encerrar chamada">📵</button>
  </div>
</div>

<!-- MODAL DE ENCERRAR -->
<div id="end-modal" class="end-modal">
  <div class="end-box">
    <h2>Encerrar chamada?</h2>
    <p>Esta é uma sessão de acesso único — uma vez que você sair, não poderá retornar.</p>
    <button class="btn-end-confirm" id="btn-end-confirm">Sim, encerrar chamada</button>
    <button class="btn-end-cancel" id="btn-end-cancel">Cancelar</button>
  </div>
</div>

<script>
var SLUG      = '<%= link.slug %>';
var TOKEN     = '<%= session.session_token %>';
var VIDEO_URL = '<%= link.video_url %>';

var hostVideo      = document.getElementById('host-video');
var localVideo     = document.getElementById('local-video');
var loadingEl      = document.getElementById('loading-overlay');
var callScreen     = document.getElementById('call-screen');
var incomingScreen = document.getElementById('incoming-screen');
var videoError     = document.getElementById('video-error');

var localStream = null;
var micOn       = true;
var camOn       = true;
var speakerOn   = true;
var callActive  = false;
var playRetries = 0;
var MAX_RETRIES = 3;

// ── Previne gestos de voltar ──────────────────────────────────────────────────
window.history.pushState(null, '', window.location.href);
window.addEventListener('popstate', function() {
  window.history.pushState(null, '', window.location.href);
  if (callActive) showEndModal();
});
document.addEventListener('contextmenu', function(e) { e.preventDefault(); });

// ── Pré-carrega o vídeo silenciosamente ──────────────────────────────────────
if (VIDEO_URL && VIDEO_URL !== 'null' && VIDEO_URL !== '') {
  hostVideo.src = VIDEO_URL;
  hostVideo.muted = true;
  hostVideo.preload = 'auto';
  hostVideo.load();
} else {
  console.warn('[Darkroom] VIDEO_URL ausente');
}

// ── Reinício do loop ─────────────────────────────────────────────────────────
hostVideo.addEventListener('ended', function() {
  hostVideo.currentTime = 0;
  hostVideo.play().catch(function() {});
});

// ── Erro de carregamento ─────────────────────────────────────────────────────
hostVideo.addEventListener('error', function() {
  hideLoading();
  if (callActive) showVideoError();
});

// ── Aceitar chamada ───────────────────────────────────────────────────────────
document.getElementById('btn-accept').addEventListener('click', function(e) {
  e.preventDefault();
  incomingScreen.style.display = 'none';
  showLoading();
  startCall();
});

function startCall() {
  callActive = true;

  // Marca sessão como ativa no servidor
  fetch('/go/' + SLUG + '/' + TOKEN + '/accept', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.success || data.blocked) {
        callActive = false;
        hideLoading();
        leaveBlank();
      }
    })
    .catch(function() {});

  // Inicia câmera local (silencioso se negar)
  if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
    navigator.mediaDevices.getUserMedia({ video: true, audio: true })
      .then(function(stream) {
        localStream = stream;
        localVideo.srcObject = stream;
      })
      .catch(function() {
        navigator.mediaDevices.getUserMedia({ video: false, audio: true })
          .then(function(stream) { localStream = stream; })
          .catch(function() {});
      });
  }

  // Toca o vídeo
  playVideo();
}

function playVideo() {
  hostVideo.currentTime = 0;
  hostVideo.muted = true; // Obrigatório no iOS/Safari para autoplay funcionar

  var playPromise = hostVideo.play();

  if (playPromise !== undefined) {
    playPromise.then(function() {
      onVideoPlaying();
    }).catch(function(err) {
      console.warn('[Darkroom] play() falhou:', err.name, err.message);

      if (playRetries < MAX_RETRIES) {
        playRetries++;
        setTimeout(playVideo, 500 * playRetries);
      } else {
        // Última tentativa: toca mutado mesmo
        hostVideo.muted = true;
        hostVideo.play().then(function() {
          speakerOn = false;
          document.getElementById('btn-speaker').textContent = '🔇';
          onVideoPlaying();
        }).catch(function() {
          hideLoading();
          showVideoError();
        });
      }
    });
  } else {
    // Navegadores antigos sem Promise
    setTimeout(function() {
      onVideoPlaying();
    }, 800);
  }
}

function onVideoPlaying() {
  hideLoading();
  callScreen.style.display = 'block';

  // Desmuta após pequeno delay (Safari exige isso)
  setTimeout(function() {
    if (speakerOn) {
      hostVideo.muted = false;
    }
  }, 300);
}

// ── Botão de retry no erro de vídeo ─────────────────────────────────────────
document.getElementById('btn-retry').addEventListener('click', function() {
  videoError.classList.remove('visible');
  playRetries = 0;
  showLoading();
  hostVideo.load();
  playVideo();
});

// ── Recusar chamada ───────────────────────────────────────────────────────────
document.getElementById('btn-decline').addEventListener('click', function(e) {
  e.preventDefault();
  leaveBlank();
});

// ── Controles ─────────────────────────────────────────────────────────────────
document.getElementById('btn-end').addEventListener('click', function(e) {
  e.preventDefault();
  e.stopPropagation();
  showEndModal();
});

document.getElementById('btn-end-confirm').addEventListener('click', function(e) {
  e.preventDefault();
  e.stopPropagation();
  endCall();
});

document.getElementById('btn-end-cancel').addEventListener('click', function(e) {
  e.preventDefault();
  e.stopPropagation();
  document.getElementById('end-modal').style.display = 'none';
});

document.getElementById('btn-mic').addEventListener('click', function() {
  if (!localStream) return;
  micOn = !micOn;
  localStream.getAudioTracks().forEach(function(t) { t.enabled = micOn; });
  this.style.opacity = micOn ? '1' : '0.4';
});

document.getElementById('btn-cam').addEventListener('click', function() {
  if (!localStream) return;
  camOn = !camOn;
  localStream.getVideoTracks().forEach(function(t) { t.enabled = camOn; });
  this.style.opacity = camOn ? '1' : '0.4';
});

document.getElementById('btn-speaker').addEventListener('click', function() {
  speakerOn = !speakerOn;
  hostVideo.muted = !speakerOn;
  this.textContent = speakerOn ? '🔊' : '🔇';
});

// ── Encerrar chamada ──────────────────────────────────────────────────────────
async function endCall() {
  callActive = false;
  hostVideo.pause();
  if (localStream) localStream.getTracks().forEach(function(t) { t.stop(); });
  try { await fetch('/go/' + SLUG + '/' + TOKEN + '/end', { method: 'POST' }); } catch(e) {}
  leaveBlank();
}

// ── Utilitários ───────────────────────────────────────────────────────────────
function showLoading() {
  loadingEl.classList.add('visible');
}
function hideLoading() {
  loadingEl.classList.remove('visible');
}
function showEndModal() {
  document.getElementById('end-modal').style.display = 'flex';
}
function showVideoError() {
  videoError.classList.add('visible');
}
function leaveBlank() {
  window.history.replaceState(null, '', '/');
  window.location.replace('about:blank');
}
</script>
</body>
</html>
