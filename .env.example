# Chamada Exclusiva - Variáveis de Ambiente

# Base URL para geração de links de chamada
# Em produção: https://seu-dominio-ou-railway-url
# Em desenvolvimento: http://localhost:3000
BASE_URL=http://localhost:3000

# Banco de dados PostgreSQL (fornecido pelo Railway)
DATABASE_URL=postgresql://user:password@host:5432/database

# Cloudinary (para upload de imagens/vídeos - opcional)
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret
CLOUDINARY_CLOUD_NAME=seu_cloud_name

# Cloudflare R2 (armazenamento de vídeos)
R2_ENDPOINT=https://seu-r2-endpoint.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET=seu-bucket-name
R2_PUBLIC_URL=https://seu-r2-public-url

# Session Secret (gerado automaticamente, ou defina um valor)
SESSION_SECRET=sua-chave-secreta-segura-aqui
